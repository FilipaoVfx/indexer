{
  "uid": "indexer-backend",
  "title": "Indexer — Backend (RED + Runtime)",
  "tags": ["indexer", "backend", "red"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(indexer_http_requests_total{job=\"indexer-backend\"}, route)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(indexer_http_requests_total{job=\"indexer-backend\"}[5m]))" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate (5xx)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "100 * sum(rate(indexer_http_requests_total{job=\"indexer-backend\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(indexer_http_requests_total{job=\"indexer-backend\"}[5m])), 1)" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latency p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(indexer_http_request_duration_seconds_bucket{job=\"indexer-backend\"}[5m])))" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "In-flight requests",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 50 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(indexer_http_requests_in_flight{job=\"indexer-backend\"})" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by route",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (route) (rate(indexer_http_requests_total{job=\"indexer-backend\",route=~\"$route\"}[5m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Responses by status class",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(indexer_http_requests_total{job=\"indexer-backend\",status_code=~\"2..\"}[5m]))", "legendFormat": "2xx" },
        { "refId": "B", "expr": "sum(rate(indexer_http_requests_total{job=\"indexer-backend\",status_code=~\"4..\"}[5m]))", "legendFormat": "4xx" },
        { "refId": "C", "expr": "sum(rate(indexer_http_requests_total{job=\"indexer-backend\",status_code=~\"5..\"}[5m]))", "legendFormat": "5xx" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency percentiles (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(indexer_http_request_duration_seconds_bucket{job=\"indexer-backend\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(indexer_http_request_duration_seconds_bucket{job=\"indexer-backend\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(indexer_http_request_duration_seconds_bucket{job=\"indexer-backend\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Handled errors by code",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 50, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (code) (rate(indexer_http_request_errors_total{job=\"indexer-backend\"}[5m]))", "legendFormat": "{{code}}" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Process memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "indexer_process_resident_memory_bytes{job=\"indexer-backend\"}", "legendFormat": "RSS" },
        { "refId": "B", "expr": "indexer_nodejs_heap_size_used_bytes{job=\"indexer-backend\"}", "legendFormat": "heap used" },
        { "refId": "C", "expr": "indexer_nodejs_heap_size_total_bytes{job=\"indexer-backend\"}", "legendFormat": "heap total" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Event-loop lag & CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [{ "matcher": { "id": "byName", "options": "cpu cores" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "custom.axisPlacement", "value": "right" }] }] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "indexer_nodejs_eventloop_lag_seconds{job=\"indexer-backend\"}", "legendFormat": "loop lag mean" },
        { "refId": "B", "expr": "indexer_nodejs_eventloop_lag_p99_seconds{job=\"indexer-backend\"}", "legendFormat": "loop lag p99" },
        { "refId": "C", "expr": "rate(indexer_process_cpu_seconds_total{job=\"indexer-backend\"}[5m])", "legendFormat": "cpu cores" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Business — ingestion & search rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (source) (rate(indexer_bookmarks_ingested_total{job=\"indexer-backend\"}[5m]))", "legendFormat": "ingested/s — {{source}}" },
        { "refId": "B", "expr": "sum by (type) (rate(indexer_search_requests_total{job=\"indexer-backend\"}[5m]))", "legendFormat": "search/s — {{type}}" }
      ]
    }
  ]
}
