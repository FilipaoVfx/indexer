PORT=8787
MAX_BATCH_SIZE=50
ALLOWED_ORIGINS=https://your-frontend.example.com,chrome-extension://<your-extension-id>

# Main Supabase table used by the backend for bookmark rows.
# Keep `bookmarks` for Indexbook, or set another table name for another topic/project.
BOOKMARKS_TABLE=bookmarks

# Optional. Defaults to true only when BOOKMARKS_TABLE=bookmarks.
# Leave disabled for cloned bookmark tables unless you also clone/update the auxiliary SQL.
# BOOKMARKS_ENABLE_SIDE_EFFECTS=false

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# The backend should prefer the service role key so DB-side RLS can stay enabled.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: used by `npm run readmes:github` to avoid unauthenticated GitHub API limits.
GITHUB_TOKEN=your-github-token
GITHUB_README_MAX_PER_BATCH=8
GITHUB_README_MAX_CHARS=300000
GITHUB_README_TTL_HOURS=168
