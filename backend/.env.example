PORT=8787
MAX_BATCH_SIZE=50
ALLOWED_ORIGINS=https://your-frontend.example.com,chrome-extension://<your-extension-id>

# ─── API Auth ─────────────────────────────────────────────────────────

# API key required (header x-api-key) on WRITE endpoints:
# POST /api/bookmarks/batch and POST /bookmarks/import-batch.
# Empty = writes are open (a warning is logged at boot). Set the same value
# in the Chrome extension popup ("API key" field) and in Render env vars.
# Generate with: openssl rand -hex 32
API_KEY=
# Set to true to also require the key on read endpoints. Default false:
# the static frontend (GitHub Pages) cannot hide a key in its bundle, so
# reads stay public and only writes are protected.
API_KEY_PROTECT_READS=false
# In-memory per-IP rate limit for write endpoints (requests per window).
WRITE_RATE_LIMIT_MAX=60
WRITE_RATE_LIMIT_WINDOW_MS=60000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# The backend should prefer the service role key so DB-side RLS can stay enabled.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Observability — Prometheus metrics endpoint (scraped by Prometheus/Grafana).
# Enabled by default. Set to false to disable the /metrics endpoint entirely.
METRICS_ENABLED=true
# Path Prometheus scrapes. Keep /metrics unless you have a reason to change it.
METRICS_PATH=/metrics
# Bearer token protecting /metrics. REQUIRED when the backend runs on a host
# separate from Prometheus (i.e. /metrics is reachable over the internet).
# Generate with: openssl rand -hex 32
# Prometheus side: authorization.credentials (or credentials_file) must match.
METRICS_TOKEN=

# Optional: used by `npm run readmes:github` to avoid unauthenticated GitHub API limits.
GITHUB_TOKEN=your-github-token
GITHUB_README_MAX_PER_BATCH=8
GITHUB_README_MAX_CHARS=300000
GITHUB_README_TTL_HOURS=168
